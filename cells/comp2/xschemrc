# Xschem configuration for comp2 characterization in gf180mcuD

# Source main project xschemrc
set SCRIPT_DIR [file dirname [file normalize [info script]]]
set PROJ_XSCHEMRC [file normalize "${SCRIPT_DIR}/schematics/xschemrc"]

if {[file exists $PROJ_XSCHEMRC]} {
    source $PROJ_XSCHEMRC
}

# Append schematics and symbol directories to library path
set SCHEM_DIR [file normalize "${SCRIPT_DIR}/schematics"]
if {[info exists XSCHEM_LIBRARY_PATH]} {
    set XSCHEM_LIBRARY_PATH "${SCHEM_DIR}:${XSCHEM_LIBRARY_PATH}"
} else {
    set XSCHEM_LIBRARY_PATH "${SCHEM_DIR}"
}
set env(XSCHEM_LIBRARY_PATH) $XSCHEM_LIBRARY_PATH

# Prevent exit code 10 on ERC in batch mode
set show_infowindow_after_netlist never
if {[info commands ::tcl_real_exit] eq ""} {
    rename exit ::tcl_real_exit
    proc exit {{code 0}} {
        if {$code == 10} {
            set code 0
        }
        ::tcl_real_exit $code
    }
}
